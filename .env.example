# Copie este arquivo para .env e ajuste os valores antes de subir em produção.

# Ambiente: development | production
NODE_ENV=development

# Porta HTTP do servidor
PORT=3000

# String de conexão do PostgreSQL
DATABASE_URL=postgres://sistema_rh:troque_esta_senha@localhost:5432/sistema_rh
DB_SSL=false

# Segredo usado para assinar cookies de sessão.
# Gere um valor forte com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Senha do usuário admin criado automaticamente na primeira execução
ADMIN_SENHA_INICIAL=

# Defina como "true" se o app rodar atrás de um proxy reverso (nginx, load balancer)
TRUST_PROXY=false
