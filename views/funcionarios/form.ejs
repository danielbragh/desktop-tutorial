<%- include('../partials/topo', { titulo: funcionario && funcionario.id ? 'Editar funcionário' : 'Novo funcionário', usuario }) %>
<div class="page-header">
  <div>
    <h1><%= funcionario && funcionario.id ? 'Editar funcionário' : 'Novo funcionário' %></h1>
  </div>
</div>

<% if (erro) { %><div class="alerta alerta-erro"><%= erro %></div><% } %>

<div class="card" style="max-width: 720px;">
  <form method="post" action="<%= funcionario && funcionario.id ? '/funcionarios/' + funcionario.id : '/funcionarios' %>">
    <div class="form-grid">
      <div class="campo">
        <label for="nome">Nome completo</label>
        <input type="text" id="nome" name="nome" value="<%= funcionario ? funcionario.nome : '' %>" required />
      </div>
      <div class="campo">
        <label for="matricula">Matrícula / ID</label>
        <input type="text" id="matricula" name="matricula" value="<%= funcionario ? funcionario.matricula : '' %>" required />
      </div>
      <div class="campo">
        <label for="cpf">CPF</label>
        <input type="text" id="cpf" name="cpf" value="<%= funcionario ? funcionario.cpf : '' %>" required placeholder="Somente números" />
      </div>
      <div class="campo">
        <label for="cargo">Cargo</label>
        <input type="text" id="cargo" name="cargo" value="<%= funcionario ? funcionario.cargo : '' %>" required />
      </div>
      <div class="campo">
        <label for="data_admissao">Data de admissão</label>
        <input type="date" id="data_admissao" name="data_admissao" value="<%= funcionario ? String(funcionario.data_admissao).slice(0,10) : '' %>" required />
      </div>
      <div class="campo">
        <label for="salario">Salário (R$)</label>
        <input type="number" id="salario" name="salario" step="0.01" min="0.01" value="<%= funcionario ? funcionario.salario : '' %>" required />
      </div>
      <div class="campo">
        <label for="tipo_vinculo">Tipo de vínculo</label>
        <select id="tipo_vinculo" name="tipo_vinculo" onchange="alternarObra()" required>
          <option value="escritorio" <%= (!funcionario || funcionario.tipo_vinculo === 'escritorio') ? 'selected' : '' %>>Escritório</option>
          <option value="obra" <%= (funcionario && funcionario.tipo_vinculo === 'obra') ? 'selected' : '' %>>Obra</option>
        </select>
      </div>
      <div class="campo" id="campo-obra">
        <label for="obra_id">Obra</label>
        <select id="obra_id" name="obra_id">
          <option value="">Selecione a obra</option>
          <% obras.forEach(function(o) { %>
            <option value="<%= o.id %>" <%= funcionario && String(funcionario.obra_id) === String(o.id) ? 'selected' : '' %>><%= o.nome %></option>
          <% }) %>
        </select>
      </div>
      <% if (funcionario && funcionario.id) { %>
      <div class="campo">
        <label for="status">Status</label>
        <select id="status" name="status" onchange="alternarDesligamento()">
          <option value="ativo" <%= funcionario.status === 'ativo' ? 'selected' : '' %>>Ativo</option>
          <option value="desligado" <%= funcionario.status === 'desligado' ? 'selected' : '' %>>Desligado</option>
        </select>
      </div>
      <div class="campo" id="campo-desligamento">
        <label for="data_desligamento">Data de desligamento</label>
        <input type="date" id="data_desligamento" name="data_desligamento" value="<%= funcionario.data_desligamento ? String(funcionario.data_desligamento).slice(0,10) : '' %>" />
      </div>
      <% } %>
    </div>
    <div class="acoes">
      <button type="submit" class="btn">Salvar</button>
      <a href="/funcionarios" class="btn btn-secundario">Cancelar</a>
    </div>
  </form>
</div>

<script>
  function alternarObra() {
    const tipo = document.getElementById('tipo_vinculo').value;
    document.getElementById('campo-obra').style.display = tipo === 'obra' ? 'flex' : 'none';
  }
  function alternarDesligamento() {
    const statusEl = document.getElementById('status');
    const campo = document.getElementById('campo-desligamento');
    if (!statusEl || !campo) return;
    campo.style.display = statusEl.value === 'desligado' ? 'flex' : 'none';
  }
  alternarObra();
  alternarDesligamento();
</script>
<%- include('../partials/rodape', { usuario }) %>
