<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Criar conta · Sistema RH</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="login-shell">
    <div class="login-card">
      <h1>Criar conta</h1>
      <p class="subtitulo">
        Sua conta ficará pendente até que um administrador aprove o acesso.
      </p>
      <% if (erro) { %>
        <div class="alerta alerta-erro"><%= erro %></div>
      <% } %>
      <% if (sucesso) { %>
        <div class="alerta alerta-info"><%= sucesso %></div>
      <% } else { %>
      <form method="post" action="/cadastro">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
        <div class="campo">
          <label for="nome">Nome</label>
          <input type="text" id="nome" name="nome" required autofocus />
        </div>
        <div class="campo" style="margin-top: 12px;">
          <label for="email">E-mail</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div class="campo" style="margin-top: 12px;">
          <label for="senha">Senha</label>
          <input type="password" id="senha" name="senha" required minlength="10" />
          <span class="nota">Mínimo 10 caracteres, com maiúscula, minúscula e número.</span>
        </div>
        <div class="campo" style="margin-top: 12px;">
          <label for="confirmar_senha">Confirmar senha</label>
          <input type="password" id="confirmar_senha" name="confirmar_senha" required minlength="10" />
        </div>
        <button type="submit" class="btn" style="width: 100%; margin-top: 18px;">Cadastrar</button>
      </form>
      <% } %>
      <p class="nota" style="margin-top: 16px; text-align: center;">
        <a href="/login">Já tem conta? Entrar</a>
      </p>
    </div>
  </div>
</body>
</html>
